  "dependencies": [
    "http"
  ],
  "after_dependencies": [
    "media_source"
  ],
  "version": "5.0.0",
  "zeroconf": [
    {
      "type": "_airplay._tcp.local.",
      "properties": {
        "manufacturer": "libratone*"
      }
    }
  ],
  "dhcp": [
    {
      "macaddress": "C467B5*"
    }
  ]
