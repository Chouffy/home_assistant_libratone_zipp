{
  "domain": "libratone_zipp",
  "name": "Libratone Zipp",
  "codeowners": [
    "@chouffy",
    "@Calyorbro"
  ],
  "config_flow": true,
  "documentation": "https://github.com/Chouffy/home_assistant_libratone_zipp",
